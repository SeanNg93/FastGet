{
  "manifest_version": 3,
  "name": "FastGet Integration",
  "description": "Send downloads and links to FastGet Download Manager.",
  "version": "1.1.0",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FastGet: capturing downloads (click to turn off)"
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "nativeMessaging",
    "cookies",
    "storage",
    "scripting",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "109",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}